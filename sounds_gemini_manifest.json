          "file": "sounds_gemini/lolo_notFound_2.wav"
        },
        {
          "text": "هاد الصنف غير متوفر بالرف هلق، خبرني بنوع تاني وبساعدك فوراً.",
          "file": "sounds_gemini/lolo_notFound_3.wav"
        }
      ],
      "idleNudge": [
        {
          "text": "محتار شو تاخد يا غالي؟ خبرني شو عبالك اليوم وأنا برتبلك السلة على ذوقك.",
          "file": "sounds_gemini/lolo_idleNudge_1.wav"
        },
        {
          "text": "خذ راحتك بالتصفح، وإذا حابب أختصر عليك الوقت بقترحلك أحلى الأصناف الطازة اليوم.",
          "file": "sounds_gemini/lolo_idleNudge_2.wav"
        },
        {
          "text": "إذا عم تقارن الأسعار، خليني أفرجيك أوفر العروض الموجودة حالياً لتوفر وقتك وميزانيتك.",
          "file": "sounds_gemini/lolo_idleNudge_3.wav"
        }
      ],
      "crossSell": [
        {
          "text": "سلتك صارت مرتبة! شو رأيك أفرجيك مكملات حلوة تناسب أغراضك قبل ما تعتمد الطلب؟",
          "file": "sounds_gemini/lolo_crossSell_1.wav"
        },
        {
          "text": "أغراضك جاهزة، بس اتأكد إذا ناقصك شي خفيف للسهرة أو المطبخ، أفرجيك المقترحات؟",
          "file": "sounds_gemini/lolo_crossSell_2.wav"
        },
        {
          "text": "اختياراتك بتشهي! نحط معها شي تكميلي خفيف يكمّل القعدة؟",

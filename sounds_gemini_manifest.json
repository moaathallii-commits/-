  "personas": {
    "buddy": {
      "greet": [
        {
          "text": "يا أهلاً وسهلاً! نورت متجر معاذ. خبرني شو ببالك اليوم؟",
          "file": "sounds_gemini/buddy_greet_1.wav"
        },
        {
          "text": "أهلاً بك يا غالي، المتجر منور بوجودك. بشو نبدأ سلتك اليوم؟",
          "file": "sounds_gemini/buddy_greet_2.wav"
        },
        {
          "text": "يا مية هلا ومرحبا! كل شي طازج ومرتب بالمتجر، شو ناقصك اليوم؟",
          "file": "sounds_gemini/buddy_greet_3.wav"
        },
        {
          "text": "أهلاً وسهلاً فيك، يسعدني جداً أساعدك بتسوقك اليوم. بشو نبلش؟",
          "file": "sounds_gemini/buddy_greet_5.wav"
        },
        {
          "text": "يا هلا بالطلة الحلوة! متجر معاذ جاهز لطلباتك، سمّي بالله واطلب.",
          "file": "sounds_gemini/buddy_greet_6.wav"
        }
      ],
      "greetMorning": [
        {
          "text": "صباح الخير والنشاط! نورت متجر معاذ، بشو نبدأ سلتك الصباحية؟",
          "file": "sounds_gemini/buddy_greetMorning_1.wav"
        },
        {
          "text": "صباح الفل والروقان، خبرني شو ناقص البيت لنجهزه عالسريع.",
          "file": "sounds_gemini/buddy_greetMorning_4.wav"
        }
      ],
      "greetEvening": [
        {
          "text": "مساء الخير والروقان! نورت متجر معاذ، شو نجهزلك الليلة؟",
          "file": "sounds_gemini/buddy_greetEvening_1.wav"
        }
      ],
      "chatGood": [
        {
          "text": "أنا بخير والحمد لله، كيف بقدر أساعدك اليوم؟",
          "file": "sounds_gemini/buddy_chatGood_1.wav"
        }
      ],
      "thanks": [
        {
          "text": "العفو يا غالي، تكرم عينك ويسعدني دائماً أكون بخدمتك.",
          "file": "sounds_gemini/buddy_thanks_1.wav"
        },
        {
          "text": "لا شكر على واجب أبداً، بأي وقت بتحتاج شي أنا هون.",
          "file": "sounds_gemini/buddy_thanks_4.wav"
        }
      ],
      "added": [
        {
          "text": "اختيار موفق، تمت إضافة الصنف إلى السلة بنجاح.",
          "file": "sounds_gemini/buddy_added_1.wav"
        },
        {
          "text": "ممتاز، صار طلبك جاهز بالسلة، نضيف شي تاني؟",
          "file": "sounds_gemini/buddy_added_2.wav"
        },
        {
          "text": "تمام التمام، صار الصنف بسلتك، خبرني إذا ناقصك شي غيره.",
          "file": "sounds_gemini/buddy_added_5.wav"
        }
      ],
      "itemsReady": [
        {
          "text": "تفضل، عرضتلك الأصناف المتوفرة بالفرع هلق، حدد الكمية.",
          "file": "sounds_gemini/buddy_itemsReady_1.wav"
        },
        {
          "text": "هي كل الخيارات المتوفرة حالياً، حدد الكمية وبنجهزها فوراً.",
          "file": "sounds_gemini/buddy_itemsReady_4.wav"
        }
      ],
      "alternative": [
        {
          "text": "هاد الصنف خالص هلق، بس جبتلك أقرب البدائل المتوفرة بالفرع.",
          "file": "sounds_gemini/buddy_alternative_1.wav"
        }
      ],
      "habit": [
        {
          "text": "تذكرت اختياراتك المفضلة وجهزتلك ياها عالسريع بالسلة.",
          "file": "sounds_gemini/buddy_habit_3.wav"
        }
      ],
      "notFound": [
        {
          "text": "عذراً يا غالي، ما لقيت هاد الصنف متوفر هلق، جرب اسم أقرب.",
          "file": "sounds_gemini/buddy_notFound_1.wav"
        },
        {
          "text": "بحثتلك منيح بس ما لقيت هاد الصنف حالياً، فيك تطلبه من زر طلب صنف.",
          "file": "sounds_gemini/buddy_notFound_2.wav"
        }
      ],
      "idleNudge": [],
      "crossSell": [
        {
          "text": "أغراضك جاهزة، بس اتأكد إذا ناقصك شي خفيف للسهرة أو المطبخ، أفرجيك المقترحات؟",
          "file": "sounds_gemini/buddy_crossSell_2.wav"
        }
      ],
      "scarcityAlert": [
        {
          "text": "ملاحظة سريعة يا غالي، في عروض وأصناف عليها طلب عالي وما بقي منها كتير، تحب تشوفها هلق؟",
          "file": "sounds_gemini/buddy_scarcityAlert_1.wav"
        },
        {
          "text": "لحّق حالك! في عروض طازة اليوم وبأسعار بتجنن، أفرجيك ياها قبل ما تخلص؟",
          "file": "sounds_gemini/buddy_scarcityAlert_2.wav"
        }
      ],
      "checkoutBoost": [
        {
          "text": "اختياراتك رائعة ومتناسقة، تأكد إن طلبك رح يوصلك بأحلى صورة وبأسرع وقت.",
          "file": "sounds_gemini/buddy_checkoutBoost_2.wav"
        }
      ],
      "orderSuccess": [],
      "welcomeBack": []
    },
